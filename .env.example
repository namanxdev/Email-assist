# Copy this file to .env (same folder) and fill in the values.
# .env is gitignored. Never commit real keys or tokens.

# --- Gemini (LLM) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Any Gemini model name. Default works for most cases.
GEMINI_MODEL=gemini-flash-latest
# Seconds before a stalled Gemini call is cut off and retried (3 attempts).
GEMINI_TIMEOUT_SECONDS=60

# --- Microsoft Graph (Outlook) ---
# Application (client) ID from entra.microsoft.com > App registrations > your app > Overview
# Example format: 00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=
# "common" = personal + work/school accounts. Use a tenant ID to lock it to one organization.
MS_TENANT=common

# --- Agent behaviour ---
# IANA timezone used to resolve "yesterday" / "tomorrow". Examples: Asia/Kolkata, Europe/London
USER_TIMEZONE=Asia/Kolkata

# --- Optional fallback ---
# If set, skips MSAL and uses this token directly (copy from Graph Explorer > Access token).
# Lasts about 1 hour and is not refreshed. Leave empty to use: uv run python -m mail_agent.auth login
GRAPH_BEARER_TOKEN=
